<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password — Alaafia Special Bread</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-body">
  <div class="auth-overlay d-flex align-items-center justify-content-center">
    <div class="col-11 col-md-4 auth-card">
      <h2 class="mb-4 text-center">Set a New Password</h2>

      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

      <form action="/reset-password/<%= token %>" method="POST">
        <div class="mb-3">
          <label class="form-label">New Password</label>
          <input type="password" name="password" class="form-control" minlength="6" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Confirm New Password</label>
          <input type="password" name="confirmPassword" class="form-control" minlength="6" required>
        </div>
        <button type="submit" class="btn btn-gold w-100">Update Password</button>
      </form>
    </div>
  </div>
</body>
</html>