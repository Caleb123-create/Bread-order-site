<%- include('partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="text-center mb-4">
      <h2>Complete Your Payment</h2>
      <p class="text-muted">Your order has been received. Please transfer the exact amount below to confirm it.</p>
    </div>

    <div class="p-4 rounded" style="background-color:#1a1a1a; border:1px solid #d4af37;">
      <p style="color:#aaa; margin-bottom:6px;">Order Reference</p>
      <p style="color:#f5f5f5; font-weight:bold; margin-bottom:20px;">#<%= order._id.toString().slice(-6) %></p>

      <p style="color:#aaa; margin-bottom:6px;">Bank</p>
      <p style="color:#f5f5f5; font-weight:bold; margin-bottom:20px;">Opay</p>

      <p style="color:#aaa; margin-bottom:6px;">Account Number</p>
      <p style="color:#d4af37; font-weight:bold; font-size:1.4rem; margin-bottom:20px;">7046252083</p>

      <p style="color:#aaa; margin-bottom:6px;">Account Name</p>
      <p style="color:#f5f5f5; font-weight:bold; margin-bottom:20px;">Olaomo Caleb Olaoluwa</p>

      <hr style="border-color:#d4af37;">

      <p style="color:#aaa; margin-bottom:6px;">Amount to Transfer</p>
      <p style="color:#d4af37; font-weight:bold; font-size:1.8rem;">₦<%= order.totalAmount.toLocaleString() %></p>
    </div>

    <div class="alert alert-warning mt-4">
      Please use your order reference (<strong>#<%= order._id.toString().slice(-6) %></strong>) as the transfer description/narration so we can match your payment quickly.
    </div>

    <div class="d-flex gap-2 mt-3">
      <a href="/orders" class="btn btn-gold w-100">I've Made the Transfer — View My Orders</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
