<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login — Alaafia Special Bread</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body style="background-color:#1a1a1a; min-height:100vh;">
  <div class="container d-flex align-items-center justify-content-center" style="min-height:100vh;">
    <div class="col-md-4">
      <h2 class="mb-4 text-center" style="color:#d4af37;">Admin Login</h2>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/admin/login" method="POST" class="p-4 rounded" style="background-color:#2a2a2a; border:1px solid #d4af37;">
        <div class="mb-3">
          <label class="form-label" style="color:#f5f5f5;">Email</label>
          <input type="email" name="email" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label" style="color:#f5f5f5;">Password</label>
          <input type="password" name="password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-gold w-100">Login</button>
      </form>
    </div>
  </div>
</body>
</html>
