<%- include('partials/header') %>

<!-- Bootstrap Carousel -->
<div id="breadCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#breadCarousel" data-bs-slide-to="0" class="active"></button>
    <button type="button" data-bs-target="#breadCarousel" data-bs-slide-to="1"></button>
    <button type="button" data-bs-target="#breadCarousel" data-bs-slide-to="2"></button>
  </div>
  <div class="carousel-inner rounded">
    <div class="carousel-item active">
      <img src="/images/slide1.jpg" class="d-block w-100 carousel-img" alt="Alaafia Special Bread">
      <div class="carousel-caption d-none d-md-block">
        <h5>Alaafia Special Bread</h5>
        <p>Baked daily, delivered warm.</p>
      </div>
    </div>
    <div class="carousel-item">
      <img src="/images/slide2.jpg" class="d-block w-100 carousel-img" alt="Alaafia Special Bread">
      <div class="carousel-caption d-none d-md-block">
        <h5>Soft, Fresh, Delicious</h5>
        <p>Made with love, every single day.</p>
      </div>
    </div>
    <div class="carousel-item">
      <img src="/images/slide3.jpg" class="d-block w-100 carousel-img" alt="Alaafia Special Bread">
      <div class="carousel-caption d-none d-md-block">
        <h5>Available in 4 Sizes</h5>
        <p>Small, Medium, Large, Very Large.</p>
      </div>
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#breadCarousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#breadCarousel" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</div>

<!-- Bread listing -->
<% breads.forEach(bread => { %>
  <div class="text-center mb-4">
    <img src="<%= bread.image %>" class="product-hero-img rounded" alt="<%= bread.name %>">
    <h2 class="mt-3 mb-1"><%= bread.name %></h2>
    <p class="text-muted"><%= bread.description %></p>
  </div>

  <h4 class="mb-3">Choose Your Size</h4>
  <div class="row g-4 mb-5">
    <% bread.sizes.forEach(s => { %>
      <div class="col-6 col-md-3">
        <div class="size-card h-100 d-flex flex-column justify-content-between">
          <div>
            <h5 class="size-name"><%= s.size.charAt(0).toUpperCase() + s.size.slice(1) %></h5>
            <p class="size-price">₦<%= s.price.toLocaleString() %></p>
          </div>
          <form action="/cart/add" method="POST">
            <input type="hidden" name="breadId" value="<%= bread._id %>">
            <input type="hidden" name="size" value="<%= s.size %>">
            <select name="quantity" class="form-select mb-2 size-qty-input">
  <% for (let i = 1; i <= 10; i++) { %>
    <option value="<%= i %>"><%= i %></option>
  <% } %>
</select>
            <button type="submit" class="btn btn-gold w-100">Add to Cart</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% }) %>

<% if (breads.length === 0) { %>
  <p class="text-muted">No breads available right now. Check back soon!</p>
<% } %>

<%- include('partials/footer') %>
