<%- include('partials/header') %>

<!-- Bootstrap Carousel -->
<div id="breadCarousel" class="carousel slide mb-5" data-bs-ride="carousel">
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#breadCarousel" data-bs-slide-to="0" class="active"></button>
    <button type="button" data-bs-target="#breadCarousel" data-bs-slide-to="1"></button>
    <button type="button" data-bs-target="#breadCarousel" data-bs-slide-to="2"></button>
  </div>
  <div class="carousel-inner rounded">
    <div class="carousel-item active">
      <img src="/images/slide1.jpg" class="d-block w-100 carousel-img" alt="Fresh Sourdough">
      <div class="carousel-caption d-none d-md-block">
        <h5>Freshly Baked Sourdough</h5>
        <p>Baked daily, delivered warm.</p>
      </div>
    </div>
    <div class="carousel-item">
      <img src="/images/slide2.jpg" class="d-block w-100 carousel-img" alt="Whole Wheat Bread">
      <div class="carousel-caption d-none d-md-block">
        <h5>Whole Wheat Goodness</h5>
        <p>Healthy and delicious, made with love.</p>
      </div>
    </div>
    <div class="carousel-item">
      <img src="/images/slide3.jpg" class="d-block w-100 carousel-img" alt="Baguette">
      <div class="carousel-caption d-none d-md-block">
        <h5>Classic French Baguette</h5>
        <p>Crispy outside, soft inside.</p>
      </div>
    </div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#breadCarousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#breadCarousel" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</div>

<!-- Bread listing -->
<h2 class="mb-4">Our Breads</h2>
<div class="row g-4">
  <% breads.forEach(bread => { %>
    <div class="col-md-4">
      <div class="card h-100">
        <img src="<%= bread.image %>" class="card-img-top bread-thumb" alt="<%= bread.name %>">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title"><%= bread.name %></h5>
          <p class="card-text text-muted"><%= bread.description %></p>

          <form action="/cart/add" method="POST" class="mt-auto">
            <input type="hidden" name="breadId" value="<%= bread._id %>">

            <div class="mb-2">
              <label class="form-label mb-1">Size</label>
              <select name="size" class="form-select">
                <% bread.sizes.forEach(s => { %>
                  <option value="<%= s.size %>">
                    <%= s.size.charAt(0).toUpperCase() + s.size.slice(1) %> — ₦<%= s.price.toLocaleString() %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="d-flex gap-2">
              <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 80px;">
              <button type="submit" class="btn btn-dark flex-grow-1">Add to Cart</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  <% }) %>

  <% if (breads.length === 0) { %>
    <p class="text-muted">No breads available right now. Check back soon!</p>
  <% } %>
</div>

<%- include('partials/footer') %>
