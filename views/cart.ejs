<%- include('partials/header') %>

<h2 class="mb-4">Your Cart</h2>

<% if (cart.length === 0) { %>
  <p class="text-muted">Your cart is empty. <a href="/">Go shopping</a></p>
<% } else { %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Bread</th>
        <th>Size</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Subtotal</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% cart.forEach(item => { %>
        <tr>
          <td><%= item.name %></td>
          <td class="text-capitalize"><%= item.size %></td>
          <td>₦<%= item.price.toLocaleString() %></td>
          <td><%= item.quantity %></td>
          <td>₦<%= (item.price * item.quantity).toLocaleString() %></td>
          <td>
            <form action="/cart/remove" method="POST">
              <input type="hidden" name="breadId" value="<%= item.breadId %>">
              <input type="hidden" name="size" value="<%= item.size %>">
              <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="d-flex justify-content-between align-items-center">
    <h4>Total: ₦<%= total.toLocaleString() %></h4>
    <a href="/checkout" class="btn btn-dark">Proceed to Checkout</a>
  </div>
<% } %>

<%- include('partials/footer') %>
