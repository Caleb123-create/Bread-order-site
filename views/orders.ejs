<%- include('partials/header') %>

<h2 class="mb-4">My Orders</h2>

<% if (orders.length === 0) { %>
  <p class="text-muted">You haven't placed any orders yet.</p>
<% } else { %>
  <% orders.forEach(order => { %>
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <h6>Order #<%= order._id.toString().slice(-6) %></h6>
          <span class="badge bg-secondary text-uppercase"><%= order.status %></span>
        </div>
        <p class="text-muted mb-1">Placed on <%= order.createdAt.toDateString() %></p>
        <ul class="mb-2">
          <% order.items.forEach(item => { %>
            <li><%= item.name %> (<%= item.size %>) x<%= item.quantity %> — ₦<%= (item.price * item.quantity).toLocaleString() %></li>
          <% }) %>
        </ul>
        <strong>Total: ₦<%= order.totalAmount.toLocaleString() %></strong>
      </div>
    </div>
  <% }) %>
<% } %>

<%- include('partials/footer') %>
